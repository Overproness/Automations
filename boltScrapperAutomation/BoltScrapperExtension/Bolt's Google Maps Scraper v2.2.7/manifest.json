{
    "manifest_version": 3,
    "name": "Bolt's Google Maps Scraper",
    "version": "2.2.7",
    "description": "Scrapes business listings from Google Maps search results.",
    "icons": {
      "16": "assets/logo.png",
      "48": "assets/logo.png",
      "128": "assets/logo.png"
    },
    "action": {
      "default_title": "Open Google Maps Scraper"
    },
    "permissions": [
      "storage",
      "downloads",
      "scripting",
      "alarms",
      "power" 
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "js/background.js"
    },
     "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Ctrl+B",
          "mac": "Command+B"
        },
        "description": "Open Google Maps Scraper"
      }
    },
    "key": "",
    "browser_specific_settings": {
      "edge": {
        "browser_action_next_to_address_bar": true
      }
    },
    "web_accessible_resources": [
      {
        "resources": [
          "html/newtab.html",
          "html/view.js",
          "js/newtab.js",
          "js/main.js",
          "js/db.js",
          "js/scraper.js",
          "js/vendor/csv.min.js",
          "js/vendor/xlsx.min.js",
          "js/vendor/dodo-payments.js",
          "js/plan-payment.js",
          "js/success.js",
          "core/get.js",
          "core/setting.js",
          "core/update.js",
          "core/tel.js",
          "core/csvtel.js",
          "core/license.js",
          "core/jwt.js",
          "core/firebase/firebase-app-compat.js",
          "core/firebase/firebase-auth-compat.js",
          "core/awake.js",
          "css/look.js",
          "assets/logo.png",
          "service.js",
          "plan/plan.html",
          "plan/success.html"
        ],
        "matches": ["<all_urls>"]
      }
    ]
  }